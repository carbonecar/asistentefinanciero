# === Telegram ===
TELEGRAM_BOT_TOKEN=your_bot_token_here

# === OpenAI ===
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# === PostgreSQL ===
POSTGRES_USER=finassist
POSTGRES_PASSWORD=changeme
POSTGRES_DB=finassist_db
# En desarrollo local usar "localhost"; en Docker usar "postgres"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full DSN (auto-built in docker-compose; override here for local dev)
# POSTGRES_DSN=postgresql+asyncpg://finassist:changeme@localhost:5432/finassist_db

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === NewsAPI ===
NEWSAPI_KEY=your_newsapi_key_here

# === Agent Tuning ===
SENTIMENT_LAMBDA=0.15
MONTE_CARLO_SIMULATIONS=5000
MONTE_CARLO_HORIZON_DAYS=252
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=asistente-financiero
