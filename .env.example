# === Telegram ===
TELEGRAM_BOT_TOKEN=your_bot_token_here

# === LLM Provider: "openai" | "ollama" ===
LLM_PROVIDER=openai

# OpenAI (requerido si LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Ollama (requerido si LLM_PROVIDER=ollama)
# Modelos con tool calling: llama3.1, mistral-nemo, qwen2.5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# === PostgreSQL ===
POSTGRES_USER=finassist
POSTGRES_PASSWORD=changeme
POSTGRES_DB=finassist_db
# En desarrollo local usar "localhost"; en Docker usar "postgres"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full DSN (auto-built in docker-compose; override here for local dev)
# POSTGRES_DSN=postgresql+asyncpg://finassist:changeme@localhost:5432/finassist_db

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === NewsAPI ===
NEWSAPI_KEY=your_newsapi_key_here

# === DB Debug ===
SQL_ECHO=false

# === Agent Tuning ===
SENTIMENT_LAMBDA=0.15
MONTE_CARLO_SIMULATIONS=5000
MONTE_CARLO_HORIZON_DAYS=252
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=asistente-financiero
SQL_ECHO=true